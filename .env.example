# Copy to .env (never committed) to change where Axol keeps things.
# Everything here is optional: the defaults are shown.

# Port on this machine for the UI (http://127.0.0.1:8000)
# AXOL_PORT=8000

# The model file inside ~/Models/Bonsai-27B (mounted read-only)
# AXOL_MODEL_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf

# Secrets (API keys) will go here later. This file is in .gitignore and
# .containerignore, so it never reaches git or an image.
