# Axol model worker: the PrismML llama.cpp fork (PQ2_0 support), built for this GPU.
# Build:  podman build -t axol-llama deploy/llama
# Everything from outside is pinned: both CUDA images by digest, the source by commit.

ARG CUDA_DEVEL=docker.io/nvidia/cuda:13.2.1-devel-ubuntu24.04@sha256:44a9504c6dfb50b1241464241b02a93871928f373de6f5a644cf5fe9f080aa63
ARG CUDA_RUNTIME=docker.io/nvidia/cuda:13.2.1-runtime-ubuntu24.04@sha256:4c17c2e7474ca1d470428b25e87e95756f51e7da3b663859894a03bc5a7ebdae

# ---- Stage 1: compile (thrown away after) ----
FROM ${CUDA_DEVEL} AS build
ARG LLAMA_REPO=https://github.com/PrismML-Eng/llama.cpp
ARG LLAMA_TAG=prism-b12128-d7b2896
ARG LLAMA_COMMIT=d7b28968306207fd176e7ff10796ccb6be607865
# RTX 5060 = Blackwell = compute capability 12.0. Another GPU needs its own number.
ARG CUDA_ARCH=120

RUN apt-get update \
 && apt-get install -y --no-install-recommends git cmake build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# A tag can be moved, so check we got the exact commit we expect.
RUN git clone --depth 1 --branch "$LLAMA_TAG" "$LLAMA_REPO" . \
 && test "$(git rev-parse HEAD)" = "$LLAMA_COMMIT"

# One static binary (no LD_LIBRARY_PATH tricks), CUDA for this GPU only, generic CPU
# code (the model runs on the GPU), no HTTPS client (it can't download models), and
# no built-in chat web page (Axol has its own UI; the build would download it).
RUN cmake -B build \
        -DGGML_CUDA=ON \
        -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
        -DBUILD_SHARED_LIBS=OFF \
        -DGGML_NATIVE=OFF \
        -DLLAMA_CURL=OFF \
        -DLLAMA_USE_PREBUILT_UI=OFF \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF \
 && cmake --build build --target llama-server -j"$(nproc)"

# ---- Stage 2: run (this is the image) ----
FROM ${CUDA_RUNTIME}
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/bin/llama-server /usr/local/bin/llama-server

RUN groupadd --system --gid 10001 llama \
 && useradd --system --no-create-home --uid 10001 --gid llama llama
USER llama

# llama-server reads LLAMA_ARG_* variables, like Axol's AXOL_* settings (lesson 1.2).
# The model and its options are set when the container runs.
ENV LLAMA_ARG_HOST=0.0.0.0 \
    LLAMA_ARG_PORT=8080
EXPOSE 8080
ENTRYPOINT ["llama-server"]
