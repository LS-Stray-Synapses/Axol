# Obsidian personal state (shared settings in docs/.obsidian are committed)
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache
docs/.trash/
.DS_Store

# Obsidian plugin code: install via Settings → Community plugins.
# Plugin list (community-plugins.json) and settings (data.json, manifest.json) are committed.
docs/.obsidian/plugins/*/main.js
docs/.obsidian/plugins/*/styles.css
docs/.obsidian/plugins/obsidian-git/

# Python
__pycache__/
*.py[oc]
*.egg-info/
.venv/

# Web (also covered by web/.gitignore)
node_modules/
web/dist/
web/test-results/
web/playwright-report/

# Local secrets (API keys go here, never in code)
.env
