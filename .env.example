# Example only: ./axol setup writes the real .env for your machine.
# (Secrets such as API keys will also go in .env later.)
# Never committed (.gitignore) and never copied into an image (.containerignore).

# Folder for your files (the agent reads and writes here)
AXOL_WORKSPACE_PATH=/home/you/Axol-workspace

# Folder for Axol's chats and memory
AXOL_DATA_PATH=/home/you/.local/share/axol

# Folder that holds the model file (mounted read-only)
AXOL_MODELS_PATH=/home/you/Models/Bonsai-27B

# Model file name inside that folder
AXOL_MODEL_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf

# Port on this machine for the UI
AXOL_PORT=8000

# GPU to use (from `nvidia-ctk cdi list`)
AXOL_GPU=nvidia.com/gpu=0

# GPU architecture to compile for (detected)
AXOL_CUDA_ARCH=120

# Context size in tokens (8192 fits 8 GB; more VRAM allows more)
AXOL_CTX_SIZE=8192
